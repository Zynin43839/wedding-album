{
  "info": {
    "name": "Wedding Album — API",
    "description": "Contract tests for the wedding-album Worker (Cloudflare Workers + R2).\n\nRun order: Health → Config → Album → Upload → Media → Rejections.\nSet `baseUrl` and `eventCode` in the environment before running.\n\nRepeatable run: every request uses a fresh uploadId, so it can be re-run without collisions.\nThe Upload folder leaves two objects in R2 per run — delete them in the dashboard, or run\nagainst the album before the QR code is shared.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8787" },
    { "key": "eventCode", "value": "demo-code" },
    { "key": "guestName", "value": "TEST-postman" },
    { "key": "uploadId", "value": "" },
    { "key": "lastKey", "value": "" },
    { "key": "lastUrl", "value": "" }
  ],
  "item": [
    {
      "name": "1 · Health",
      "item": [
        {
          "name": "P01 page loads",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('html + utf-8', () => {",
                  "  pm.expect(pm.response.headers.get('content-type')).to.include('text/html');",
                  "  pm.expect(pm.response.headers.get('content-type')).to.include('utf-8');",
                  "});",
                  "pm.test('has app markup', () => pm.expect(pm.response.text()).to.include('id=\"eventNames\"'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/?e={{eventCode}}", "host": ["{{baseUrl}}"], "path": [""], "query": [{ "key": "e", "value": "{{eventCode}}" }] }
          }
        },
        {
          "name": "P04 static assets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('css content-type', () => pm.expect(pm.response.headers.get('content-type')).to.include('text/css'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/styles.css", "host": ["{{baseUrl}}"], "path": ["styles.css"] }
          }
        },
        {
          "name": "P06 unknown path 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/no-such-page", "host": ["{{baseUrl}}"], "path": ["no-such-page"] }
          }
        }
      ]
    },
    {
      "name": "2 · Config",
      "item": [
        {
          "name": "P10 config ok",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('required keys', () => {",
                  "  ['title','names','date','maxPhotoMb','maxVideoMb'].forEach(k => pm.expect(d).to.have.property(k));",
                  "});",
                  "pm.test('limits are positive numbers', () => {",
                  "  pm.expect(d.maxPhotoMb).to.be.a('number').and.above(0);",
                  "  pm.expect(d.maxVideoMb).to.be.a('number').and.above(0);",
                  "});",
                  "pm.collectionVariables.set('maxPhotoMb', d.maxPhotoMb);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/config?e={{eventCode}}", "host": ["{{baseUrl}}"], "path": ["api", "config"], "query": [{ "key": "e", "value": "{{eventCode}}" }] }
          }
        },
        {
          "name": "P11 config without code → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));",
                  "pm.test('bad_code', () => pm.expect(pm.response.json().error).to.eql('bad_code'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/config", "host": ["{{baseUrl}}"], "path": ["api", "config"] }
          }
        },
        {
          "name": "P12 config with wrong code → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('403', () => pm.response.to.have.status(403));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/config?e=wrong-code", "host": ["{{baseUrl}}"], "path": ["api", "config"], "query": [{ "key": "e", "value": "wrong-code" }] }
          }
        }
      ]
    },
    {
      "name": "3 · Album",
      "item": [
        {
          "name": "P14 list album",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('items is an array', () => pm.expect(d.items).to.be.an('array'));",
                  "pm.test('has cursor key', () => pm.expect(d).to.have.property('cursor'));",
                  "if (d.items.length) {",
                  "  const it = d.items[0];",
                  "  pm.test('item shape', () => {",
                  "    ['id','ts','guest','type','size','url','thumb'].forEach(k => pm.expect(it).to.have.property(k));",
                  "  });",
                  "  pm.collectionVariables.set('firstUrl', it.url);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/list?e={{eventCode}}", "host": ["{{baseUrl}}"], "path": ["api", "list"], "query": [{ "key": "e", "value": "{{eventCode}}" }] }
          }
        },
        {
          "name": "P15 list without code → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('403', () => pm.response.to.have.status(403));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/list", "host": ["{{baseUrl}}"], "path": ["api", "list"] }
          }
        }
      ]
    },
    {
      "name": "4 · Upload",
      "item": [
        {
          "name": "P20 upload photo (pick a file)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('uploadId', 'pm' + Date.now());"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('ok true', () => pm.expect(d.ok).to.eql(true));",
                  "pm.test('key starts with m/', () => pm.expect(d.key).to.match(/^m\\//));",
                  "pm.collectionVariables.set('lastKey', d.key);",
                  "pm.collectionVariables.set('lastUrl', d.url);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "content-type", "value": "image/jpeg" }],
            "body": { "mode": "binary", "binary": {} },
            "url": {
              "raw": "{{baseUrl}}/api/upload?e={{eventCode}}&id={{uploadId}}&kind=photo&ext=jpg&name={{guestName}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "upload"],
              "query": [
                { "key": "e", "value": "{{eventCode}}" },
                { "key": "id", "value": "{{uploadId}}" },
                { "key": "kind", "value": "photo" },
                { "key": "ext", "value": "jpg" },
                { "key": "name", "value": "{{guestName}}" }
              ]
            }
          },
          "description": "Body → binary → Select File. Any JPEG works; a real 1–3 MB phone photo is the useful test."
        },
        {
          "name": "P21 uploaded id is in the album",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const id = pm.collectionVariables.get('uploadId');",
                  "const ids = pm.response.json().items.map(i => i.id);",
                  "pm.test('uploaded id is listed', () => pm.expect(ids).to.include(id));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/list?e={{eventCode}}", "host": ["{{baseUrl}}"], "path": ["api", "list"], "query": [{ "key": "e", "value": "{{eventCode}}" }] }
          }
        },
        {
          "name": "P23 upload thumbnail",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('thumb suffix', () => pm.expect(pm.response.json().key).to.match(/-t\\.[a-z0-9]+$/));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "content-type", "value": "image/jpeg" }],
            "body": { "mode": "binary", "binary": {} },
            "url": {
              "raw": "{{baseUrl}}/api/upload?e={{eventCode}}&id={{uploadId}}&kind=thumb&ext=jpg&name={{guestName}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "upload"],
              "query": [
                { "key": "e", "value": "{{eventCode}}" },
                { "key": "id", "value": "{{uploadId}}" },
                { "key": "kind", "value": "thumb" },
                { "key": "ext", "value": "jpg" },
                { "key": "name", "value": "{{guestName}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5 · Media",
      "item": [
        {
          "name": "P22 fetch the uploaded media",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('image/jpeg', () => pm.expect(pm.response.headers.get('content-type')).to.include('image/jpeg'));",
                  "pm.test('immutable cache', () => pm.expect(pm.response.headers.get('cache-control') || '').to.include('immutable'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/i/{{lastKey}}", "host": ["{{baseUrl}}"], "path": ["i", "{{lastKey}}"] }
          },
          "description": "Uses the same-origin /i/ proxy. If PUBLIC_MEDIA_BASE is set, the app uses that URL instead — paste `lastUrl` into a new request to check the CDN path."
        },
        {
          "name": "P32 missing key → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/i/m/1700000000000-missing.jpg", "host": ["{{baseUrl}}"], "path": ["i", "m", "1700000000000-missing.jpg"] }
          }
        },
        {
          "name": "P31 traversal → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/i/m/..%2Fsecret.txt", "host": ["{{baseUrl}}"], "path": ["i", "m", "..%2Fsecret.txt"] }
          }
        }
      ]
    },
    {
      "name": "6 · Rejections",
      "item": [
        {
          "name": "P25 bad kind → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('bad_kind', () => pm.expect(pm.response.json().error).to.eql('bad_kind'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "content-type", "value": "image/jpeg" }],
            "body": { "mode": "raw", "raw": "x", "options": { "raw": { "language": "text" } } },
            "url": {
              "raw": "{{baseUrl}}/api/upload?e={{eventCode}}&id=pm-reject-01&kind=bogus&ext=jpg",
              "host": ["{{baseUrl}}"],
              "path": ["api", "upload"],
              "query": [
                { "key": "e", "value": "{{eventCode}}" },
                { "key": "id", "value": "pm-reject-01" },
                { "key": "kind", "value": "bogus" },
                { "key": "ext", "value": "jpg" }
              ]
            }
          }
        },
        {
          "name": "P26 bad id → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('bad_id', () => pm.expect(pm.response.json().error).to.eql('bad_id'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "content-type", "value": "image/jpeg" }],
            "body": { "mode": "raw", "raw": "x", "options": { "raw": { "language": "text" } } },
            "url": {
              "raw": "{{baseUrl}}/api/upload?e={{eventCode}}&id=abc&kind=photo&ext=jpg",
              "host": ["{{baseUrl}}"],
              "path": ["api", "upload"],
              "query": [
                { "key": "e", "value": "{{eventCode}}" },
                { "key": "id", "value": "abc" },
                { "key": "kind", "value": "photo" },
                { "key": "ext", "value": "jpg" }
              ]
            }
          }
        },
        {
          "name": "P28 wrong content-type → 415",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('415', () => pm.response.to.have.status(415));",
                  "pm.test('bad_type', () => pm.expect(pm.response.json().error).to.eql('bad_type'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "content-type", "value": "text/plain" }],
            "body": { "mode": "raw", "raw": "not an image", "options": { "raw": { "language": "text" } } },
            "url": {
              "raw": "{{baseUrl}}/api/upload?e={{eventCode}}&id=pm-reject-02&kind=photo&ext=jpg",
              "host": ["{{baseUrl}}"],
              "path": ["api", "upload"],
              "query": [
                { "key": "e", "value": "{{eventCode}}" },
                { "key": "id", "value": "pm-reject-02" },
                { "key": "kind", "value": "photo" },
                { "key": "ext", "value": "jpg" }
              ]
            }
          }
        },
        {
          "name": "P30 GET upload → 405",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('405', () => pm.response.to.have.status(405));",
                  "pm.test('method', () => pm.expect(pm.response.json().error).to.eql('method'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/upload?e={{eventCode}}", "host": ["{{baseUrl}}"], "path": ["api", "upload"], "query": [{ "key": "e", "value": "{{eventCode}}" }] }
          }
        }
      ]
    }
  ]
}
